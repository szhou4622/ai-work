# AI 多 Agent 开发工作台 · 环境变量配置示例
# 复制为 .env 并填写实际值

# 服务端口（默认 8620）
PORT=8620

# 监听地址（0.0.0.0 允许外部访问，127.0.0.1 仅本地）
HOST=0.0.0.0

# 数据存储目录（存放 SQLite、日志、运行输出）
DATA_DIR=./data

# 访问口令（首次启动时设置；若不设置则自动生成并打印一次）
# 强烈建议生产环境设置强密码
ACCESS_PASSWORD=your_secure_password_here

# Node.js 环境（生产环境设置为 production）
NODE_ENV=development
